{
  "name": "cli-agent",
  "version": "1.0.0",
  "description": "Terminal workspace manager with split-pane bookmarks for launching AI agents (Claude Code, Copilot, etc.) in project directories",
  "main": "src/index.js",
  "bin": {
    "cli-agent": "./bin/cli-agent.js"
  },
  "scripts": {
    "start": "node bin/cli-agent.js",
    "sidebar": "node bin/cli-agent.js --sidebar",
    "test": "node --test",
    "check": "node -e \"for (const f of require('fs').readdirSync('src')) require('./src/' + f)\" && node --test"
  },
  "keywords": [
    "cli",
    "agent",
    "ai",
    "claude-code",
    "copilot",
    "workspace",
    "bookmarks",
    "terminal",
    "tmux",
    "developer-tools"
  ],
  "author": "juliendevelopment",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliendevelopment/cli-agent.git"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
